# Copia a .env y personaliza. SESSION_SECRET: cadena aleatoria larga.
PORT=3000
NODE_ENV=development
SESSION_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_LARGO_Y_ALEATORIO
# Correo autorizado para la promoción manual; el registro público no concede admin.
ADMIN_EMAIL=tu-correo-de-administracion@example.com
# DB_PATH=data/codigoclaro.sqlite
# En Render, Cloudflare valida y sustituye CF-Connecting-IP antes del origen.
# Solo habilítalo si la capa proxy que controla esa cabecera está configurada.
# TRUST_CF_CONNECTING_IP=true
