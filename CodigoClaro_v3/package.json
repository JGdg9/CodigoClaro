{
  "name": "codigoclaro-piloto",
  "version": "1.4.2",
  "private": true,
  "description": "CódigoClaro: plataforma educativa de programación para DAM y DAW, con temarios ampliados, prácticas y seguimiento del aprendizaje",
  "main": "server.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build:react-preview": "node scripts/build-react-preview.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "db:migrate": "node scripts/migrate-db.js",
    "docs:build": "python scripts/generar_temarios.py",
    "test:coverage": "node --experimental-test-coverage --test --test-concurrency=1 tests/*.test.js",
    "test:render": "node scripts/smoke-render.js",
    "start:postgres": "node server-postgres.js",
    "migrate:postgres": "node scripts/migrate-postgres.js",
    "test:postgres": "node --test tests/postgres.integration.test.js",
    "quizzes:build": "node scripts/generar_banco_aula.js"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@babel/standalone": "7.29.11",
    "dompurify": "3.4.17",
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
